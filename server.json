{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wiltodelta/remove-ai-watermarks",
  "title": "Remove AI Watermarks",
  "description": "Identify and clean AI watermarks and provenance in your own images, video, and text.",
  "version": "0.58.0",
  "repository": {
    "url": "https://github.com/wiltodelta/remove-ai-watermarks",
    "source": "github"
  },
  "websiteUrl": "https://github.com/wiltodelta/remove-ai-watermarks/blob/main/docs/mcp-server.md",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "remove-ai-watermarks",
      "version": "0.58.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--python",
          "value": "3.12"
        },
        {
          "type": "named",
          "name": "--with",
          "value": "remove-ai-watermarks[all,classify-onnx,text-draft]"
        }
      ]
    }
  ]
}
